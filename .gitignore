# Android release signing. The keystore identifies every build as coming
# from the same source; anyone holding it could sign an APK that Android
# accepts as an update to this app. It never belongs in the repository,
# public or otherwise.
frontend/android/keystore/
*.jks
*.keystore
keystore.properties

# Built installers. These are attached to GitHub Releases instead, which
# is where large binaries belong.
dist-release/
