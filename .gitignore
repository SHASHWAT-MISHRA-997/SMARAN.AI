# Security & Secrets Protection
# `.env*` rather than `.env` and `*.env`: those two miss anything with a
# suffix, so a `.env.backup` or `.env.old` sitting in the tree would have been
# committable. A template is the one thing worth tracking, so it is excepted.
.env*
!.env.example
*.env
litellm_config.yaml
*.pem
*.key
*.secret

# Runtime Data, Uploads, DBs & Embeddings
backend/data/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
chroma/
uploads/

# Dependencies & Build Artefacts
frontend/node_modules/
frontend/dist/
backend/venv/
.venv/
node_modules/
dist/
build/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd

# Packaged Binaries, Installers & Large Archives
*.zip
*.tar
*.gz
*.7z
*.rar
*.bin
*.safetensors
*.gguf
*.pt
*.onnx
*.exe
SMARAN_AI.spec

# Personal / Non-Software Data
GMRPL AI/
Attendance_Report/

# OS & Workspace Files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Logs & System Test Traces
*.log
.tempmediaStorage/
.user_uploaded/
.system_generated/
test-results/
playwright-report/

# Android release signing. The keystore identifies every build as coming
# from the same source; anyone holding it could sign an APK that Android
# accepts as an update to this app. It never belongs in the repository,
# public or otherwise.
frontend/android/keystore/
*.jks
*.keystore
keystore.properties

# Built installers. These are attached to GitHub Releases instead, which
# is where large binaries belong.
dist-release/

# Generated at build time; carries the analytics ingest key.
backend/app/analytics_config.py

# The saved Google client id. Not a secret, but it is per-installation
# configuration rather than source.
backend/data/google_oauth.json

# CLI build artefacts
cli/build/
cli/dist/
cli/*.egg-info/
cli/smaran_cli.egg-info/
