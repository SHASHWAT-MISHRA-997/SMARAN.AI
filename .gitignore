# Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*-key.txt
ingest-key.txt
manifest-key.txt
extension-key.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.spec.bak
*.exe
*.app
*.deb
*.rpm

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Node (if used by extension tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.huggingface/
.localpycs/

# Logs
*.log
logs/
# Android release signing. The keystore signs every APK that claims to be
# SMARAN.AI, and keystore.properties holds its passwords in plain text.
# Neither belongs in a repository - anyone holding them can publish an
# update that Android accepts as genuinely yours.
frontend/android/keystore/
frontend/android/keystore.properties
*.jks
*.keystore

# Build and tool output, not source.
.netlify/
frontend/playwright-report/
frontend/test-results/
frontend/android/.gradle-user/
cli/build-exe/
cli/smaran_cli.egg-info/
*.apk.idsig

# Downloaded models, vector stores and the local database. data/ alone is
# about 6 GB and backend/data/ another 1.6 GB - machine state, not source,
# and past GitHub's 100 MB per-file limit either way. `git add -A` was
# silently staging nothing because it choked walking these.
data/
backend/data/
dist-release/
.pet-work/


# The APK is copied in before a deploy so the site can serve it directly;
# it is a release artefact, not source.
website/downloads/

# Local runtime database. Created on first run; never a source artefact.
backend/smaran.db

# Linux build output (first genuine Linux build, 2.10.38). Artifacts only.
build-linux/

# Installer output. Same class as dist-release/ and build-linux/ above, which
# are already ignored - it was simply missed. It also cannot be committed even
# if someone wanted to: SMARAN.AI-Setup.exe and the portable zip are 290 MB and
# 396 MB, and GitHub refuses any file over 100 MB, so a commit containing them
# produces a local history that can never be pushed.
installer/output/

# Screenshots and UI dumps from manual testing sessions. Kept on disk, out of
# history - the same thing .cache/audit/ holds, and that is ignored too. The
# only debug PNGs ever committed at the root, exe_final.png and exe_shot.png,
# look like accidents rather than a convention worth following.
/phone_*.png
/t_*.png
/voice_*.png
/rebuild_*.png
/boat_frames.png
/lantern_frames.png
/taxi_frame.png
/video_frame.png
/mobile_chat_history_verified.png
/m[0-9]*.png
/n[0-9]*.png
/*_dump.xml
