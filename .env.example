# SMARAN AI CONFIGURATION TEMPLATE
# Hardware scan defaults: CPU=16 RAM=16GB VRAM=6GB GPU=NVIDIA RTX

# Security & Secrets
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_key_12345
POSTGRES_USER=smaran_admin
POSTGRES_PASSWORD=smaran_secure_password
POSTGRES_DB=smaran_db

# Service Binds
BACKEND_PORT=3003
FRONTEND_PORT=3003

# Inference Engine Configuration
INFERENCE_ENGINE=vllm
ACTIVE_MODEL=Qwen/Qwen3-4B-AWQ
MAX_MODEL_LEN=8192
VLLM_QUANTIZATION=awq
VLLM_URL=http://smaran-inference:8000/v1
OLLAMA_URL=http://127.0.0.1:11434

# Free local image generation. First launch downloads the model once; set
# OFFLINE_ONLY=1 after it is cached to guarantee no network access.
LOCAL_IMAGE_MODEL=stabilityai/sd-turbo
LOCAL_IMAGE_OFFLINE_ONLY=0
