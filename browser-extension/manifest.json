{
  "manifest_version": 3,
  "name": "SMARAN.AI for Chrome",
  "version": "1.0.0",
  "description": "Ask SMARAN.AI about the page you are on, and let it act on that page when you allow it.",

  "_comment_key": "Fixes the extension id so the desktop app can allow exactly this origin instead of every extension.",
  "key": "",

  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],

  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "SMARAN.AI" },

  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },

  "content_security_policy": {
    "extension_pages": "script-src '''self'''; object-src '''self'''"
  }
}
