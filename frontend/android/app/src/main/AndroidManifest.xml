<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">



    <!-- Permissions -->


    <!-- Android 11 hides other apps from this one unless it says what it
         needs to see, and the speech recogniser is another app.

         Without this, SpeechRecognizer.isRecognitionAvailable() returns
         false on every device running Android 11 or newer - not because the
         recogniser is missing, but because this app is not allowed to look
         for it. The failure is silent: no exception, no log from the app,
         just a flat "no". That is what "Voice input unavailable" has been
         on the phone, on a device with Google's speech service installed
         and working everywhere else.

         QUERY_ALL_PACKAGES would also fix it and is the wrong answer: Play
         treats it as a dangerous permission and this only needs to see two
         services. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- "Chrome kholo" has to be turned into a package before anything can
             be launched, which means seeing what is installed. MAIN/LAUNCHER
             shows only apps that appear in the launcher - exactly the set a
             person can name out loud - and unlike QUERY_ALL_PACKAGES it is not
             a permission Play asks anyone to justify. Same reasoning as the
             two entries above. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Opening a web address, and asking whichever music app the user
             chose to play something. Neither names a package. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reaching the paired desktop over the local network, and noticing when
         that network changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Speak: the microphone. Gesture Mode and screen vision: the camera. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Listening while the app is not on screen.
         Without a foreground service the activity is stopped the moment another
         app opens, and a stopped activity hears nothing - so a second spoken
         command never worked. Android 14 requires the microphone type to be
         declared alongside the generic permission, and Android 13 requires
         asking before a notification can be posted; the service cannot run
         without its notification, so both are needed for it to start at all. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declared as optional so the app still installs on hardware without
         them; the features that need them explain themselves at runtime. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- supportsPictureInPicture, so the call can shrink into a floating
             window and stay visible over whatever it was just asked to open.
             It relies on the configChanges below: the activity already handles
             screenSize and screenLayout itself, which is what resizing into
             and out of that window produces. Without them Android recreates
             the activity, and the call would restart the moment it floated. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Keeps listening while another app is in front. Not exported: it is
             started by this app and by its own notification action, and nothing
             else has any business starting something that holds a microphone. -->
        <service
            android:name=".SmaranVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
